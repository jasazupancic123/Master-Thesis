cd fitcode-backend-nest || exit 1

echo "\n🚧 Running unit tests..."
npm test || exit 1

echo "\n🚧 Running E2E tests..."
npm run test:e2e || exit 1

echo "\n🛠️ Building backend..."
npm run build || exit 1

echo "\n🚀 Starting server..."
npx wait-on http://localhost:3001 &

# Run `start:prod` for just long enough to ensure it starts
npm run start:prod &
DEV_PID=$!
sleep 1
kill $DEV_PID

echo "\n✅ Server started successfully!"