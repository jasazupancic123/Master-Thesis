cd fitcode-backend-nest || exit 1

print_box() {
  local message="$1"
  local h_padding=4
  local v_padding=1
  local border_char="─"
  local corner_tl="┌"
  local corner_bl="└"
  local side="│"

  # Strip ANSI and emoji chars for length calculation
  local clean_message=$(echo -e "$message" | sed -E 's/\x1B\[[0-9;]*[mGKH]//g' | awk '{gsub(/[^[:print:]]/, ""); print}')
  local clean_length=$(echo -n "$clean_message" | wc -m)
  local box_width=$((clean_length + 2 * h_padding))

  # Top border (only left corner + top line)
  printf "\n%s" "$corner_tl"
  printf "%*s\n" "$box_width" "" | tr ' ' "$border_char"

  # Top padding
  for _ in $(seq 1 $v_padding); do
    printf "%s\n" "$side"
  done

  # Message line
  printf "%s%*s%s\n" "$side" $h_padding "" "$message"

  # Bottom padding
  for _ in $(seq 1 $v_padding); do
    printf "%s\n" "$side"
  done

  # Bottom border (only left corner + bottom line)
  printf "%s" "$corner_bl"
  printf "%*s\n" "$box_width" "" | tr ' ' "$border_char"
}

print_box "🚧 Running unit tests..."
npm test || exit 1

print_box "🚧 Running E2E tests..."
npm run test:e2e || exit 1

print_box "🛠️ Building backend..."
npm run build || exit 1

print_box "🚀 Starting server..."
npx wait-on http://localhost:3001 &

# Run `start:prod` for just long enough to ensure it starts
npm run start:prod &
DEV_PID=$!
sleep 1
kill $DEV_PID

print_box "✅ Server started successfully!"