rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {
        // Allow only admin to create, update and delete components, but allow all authenticated users to read them
        match /components/{component=**} {
            allow create, update, delete: if request.auth != null && 'admin' in request.auth.token.role;
            allow read: if request.auth != null;
        }
    }
}