{
  "compilerOptions": {
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ],
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "jest", 
      "node"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/components/mediapipe-react-app/components/CameraSquat/Utils.js",
    "src/components/mediapipe-react-app/components/CameraSquat/CameraSquat.js",
    "src/components/mediapipe-react-app/components/CameraSquat/CameraSquat.js",
    "src/common/type/svgr.d.ts",
    "jest.setup.js",
    "jest.config.ts"
, "src/components/training-exercise-card/components/training-exercise-card-sets/components/training-exercise-card-sets-collapsed/training-exercise-card-collapsed-sets.-stubtsx"  ],
  "exclude": [
    "node_modules"
  ]
}
